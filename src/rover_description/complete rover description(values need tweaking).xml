<?xml version="1.0"?>
<robot name="salvage_rover" xmlns:xacro="http://www.ros.org/wiki/xacro">
<link name="chassis">
 <visual>
  <origin xyz="0 0 0" rpy="0 0 0"/>
  <geometry>
    <box size="0.3 0.3 0.15"/>
    </geometry>
    <material name="placeholder">
     <color rgba="0 0 1 1"/>
    </material>
 </visual>
 
 <collision>
  <origin xyz="0 0 0" rpy="0 0 0"/>
  <geometry>
   <box size="0.3 0.3 0.15"/>
  </geometry>
 </collision>

 <inertial>
  <origin xyz="0 0 0" rpy="0 0 0"/>
  <mass value="1.0"/>
  <inertia ixx="0.01" ixy="0.0" ixz="0.0"
            iyy="0.01" iyz="0.0"
            izz="0.01"/>
  </inertial>
</link>

<link name="left_back_wheel">
 <visual>
  <origin xyz="-0.075 -0.075 0"/>
  <geometry>
   <cylinder radius="0.25" length="0.04"/>
  </geometry>
  <material name="placeholder">
  <color rgba="0 0 1 1"/>
  </material>
 </visual>

 <collision>
  <origin xyz="-0.075 -0.075 0" rpy="0 0 0"/>
  <geometry>
    <cylinder radius="0.25" length="0.04"/>
  </geometry>
 </collision>

 <inertial>
  <origin xyz="-0.075 -0.075 0" rpy ="0 0 0"/>
  <mass value="0.1"/>
  <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.00" iyz="0.0" izz="0.001"/>
 </inertial>
</link>

<joint name="chassis_to_left_back_wheel" type="continuous">
    <parent link="chassis"/>
    <child link="left_back_wheel"/>
    <origin xyz="-0.075 -0.075 0" rpy="1.5 0 0"/>
    <axis xyz="0 0 1"/>
</joint>

